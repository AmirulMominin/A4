model User{
    id String @id @default(uuid())
    name String @db.VarChar(255)
    email String @unique
    password String
    role Role 
    status UserStatus @default(ACTIVE)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    
    properties Properties?

    @@map("users")
}

enum Role {
    Tenant
    Landlord
    Admin
}

enum UserStatus {
    ACTIVE
    BANNED
}