model Properties {
    id String @id @default(uuid())
    name String
    details String
    rent Decimal @db.Decimal(10, 2)
    type PropertyType
    location String
    status PropertyStatus @default(AVAILABLE)
    landlordId String 
    landlord User @relation(fields: [landlordId], references: [id])

    categoryId String
    category Category @relation(fields: [categoryId], references: [id])
    
    rental Rental[]


    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt


    @@map("properties")
}

enum PropertyStatus {
    RENTED
    AVAILABLE
}

enum PropertyType {
    FLAT
    APARTMENT
    House
    PLOT

}